{
  "name": "@agentvault/sdk",
  "version": "0.1.0",
  "description": "Server-side TypeScript client for AgentVault reads and Devnet Model A payment-intent intake",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs"
  }
}
